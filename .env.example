# ProCAT environment variables
#
# Copy this file to `.env` and fill in the values you need (`.env` is read
# automatically by Docker Compose and is git-ignored, so secrets never get
# committed). Every variable below is optional unless marked MANDATORY.
#
# See README.md for how the different run modes (development, production-like
# local, production) select which of these apply.

# ─────────────────────────────────────────────────────────────────────────
# Settings module (procat/settings/)
# ─────────────────────────────────────────────────────────────────────────

# Selects which settings file Django loads.
# Optional. Default: procat.settings (local development settings, DEBUG=True).
# Set to procat.settings._production for production-like/production runs.
# DJANGO_SETTINGS_MODULE=procat.settings._production

# ─────────────────────────────────────────────────────────────────────────
# procat/settings/_production.py
# Only read when DJANGO_SETTINGS_MODULE=procat.settings._production.
# ─────────────────────────────────────────────────────────────────────────

# Django's cryptographic signing key, used for sessions, CSRF tokens, etc.
# MANDATORY in production-like/production mode (startup fails without it).
# Not used in local development, which has a hardcoded insecure default.
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Comma-separated list of hostnames the app is allowed to serve.
# Optional. Default: localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of scheme+host origins trusted as the source of
# unsafe (POST, etc.) requests, e.g. https://your-domain.com
# Optional. Default: http://localhost
CSRF_TRUSTED_ORIGINS=http://localhost

# ─────────────────────────────────────────────────────────────────────────
# procat/settings/settings.py (read in every mode)
# ─────────────────────────────────────────────────────────────────────────

# URL suffix used as the root path after the hostname, e.g. "/procat" if the
# app is served from a sub-path rather than the domain root. If set, it must
# also match the path used in the Caddyfile.
# Optional. Default: "" (app served at the domain root).
PROCAT_SCRIPT_NAME=

# API key and workspace ID used to sync time entries from Clockify.
# Optional as individual variables, but BOTH are required together for the
# Clockify sync task to run; if either is unset, the sync is skipped (and
# logged as a warning) rather than failing.
CLOCKIFY_API_KEY=
CLOCKIFY_WORKSPACE_ID=

# Azure OIDC / SSO login configuration.
# Optional as a whole, but if you want SSO login enabled, ALL SIX of
# OIDC_RP_CLIENT_ID, OIDC_RP_CLIENT_SECRET, OIDC_OP_AUTHORIZATION_ENDPOINT,
# OIDC_OP_TOKEN_ENDPOINT, OIDC_OP_USER_ENDPOINT and OIDC_OP_JWKS_ENDPOINT are
# MANDATORY together. If any one of them is missing, OIDC is disabled and the
# app falls back to local username/password accounts (registration/login
# forms) instead.
# These values come from an app registration in Azure Active Directory / Entra ID.
# See: https://learn.microsoft.com/en-us/entra/identity-platform/quickstart-register-app
# and https://mozilla-django-oidc.readthedocs.io/en/stable/installation.html
# for how to obtain/configure them.
OIDC_RP_CLIENT_ID=
OIDC_RP_CLIENT_SECRET=
OIDC_OP_AUTHORIZATION_ENDPOINT=
OIDC_OP_TOKEN_ENDPOINT=
OIDC_OP_USER_ENDPOINT=
OIDC_OP_JWKS_ENDPOINT=

# Space-separated list of OIDC scopes to request.
# Optional. Default (from mozilla-django-oidc): "openid email"
OIDC_RP_SCOPES=openid email profile

# Algorithm used to verify the OIDC provider's signed tokens.
# Optional. Default: RS256
OIDC_RP_SIGN_ALGO=RS256
